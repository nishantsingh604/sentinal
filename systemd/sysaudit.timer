# /etc/systemd/system/sysaudit.timer
# Requirement 3 scheduler: midnight, every 3rd day of the month (1,4,7,...,31).
[Unit]
Description=Run sysaudit maintenance at midnight every 3 days

[Timer]
OnCalendar=*-*-1/3 00:00:00
Persistent=true
Unit=sysaudit-cleanup.service

[Install]
WantedBy=timers.target